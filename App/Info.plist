<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>SCAD Quick Look</string>
  <key>CFBundleDisplayName</key><string>SCAD Quick Look</string>
  <key>CFBundleExecutable</key><string>ScadQuickLook</string>
  <key>CFBundleIdentifier</key><string>com.greegus.ScadQuickLook</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>

  <!-- .scad has no system UTI (Finder sees it as dyn.…), so we export one ourselves -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>org.openscad.scad</string>
      <key>UTTypeDescription</key><string>OpenSCAD Source</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.plain-text</string>
        <string>public.source-code</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>scad</string></array>
        <key>public.mime-type</key><array><string>application/x-openscad</string></array>
      </dict>
    </dict>
  </array>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>OpenSCAD Source</string>
      <key>CFBundleTypeRole</key><string>QLGenerator</string>
      <key>LSItemContentTypes</key><array><string>org.openscad.scad</string></array>
      <key>LSHandlerRank</key><string>None</string>
    </dict>
  </array>
</dict>
</plist>
